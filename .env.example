# Prisma (SQLite for local/dev; swap to a hosted Postgres URL for serverless deploys)
DATABASE_URL="file:./dev.db"

# 관리자 로그인 비밀번호 (평문으로 넣으면 최초 실행 시 자동으로 해시되어 사용됩니다)
ADMIN_PASSWORD="changeme"

# 세션 쿠키 서명용 비밀키 (32자 이상 임의 문자열로 변경하세요)
SESSION_SECRET="replace-this-with-a-long-random-string"

# /api/cron/crawl 호출을 인증하기 위한 시크릿 (Vercel Cron이 Authorization: Bearer <값> 헤더로 전송)
CRON_SECRET="replace-this-with-a-long-random-string"

# Kaggle 대회 크롤링용 (https://www.kaggle.com/settings -> API -> Create New Token 에서 발급)
KAGGLE_USERNAME=""
KAGGLE_KEY=""
